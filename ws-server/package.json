{
  "name": "kaleb-voice-ws-server",
  "version": "1.0.0",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build --target=bun src/index.ts --outdir=dist",
    "test": "bun test src",
    "typecheck": "bunx tsc --noEmit -p .",
    "fish:create-voice": "bun scripts/create-fish-voice.ts",
    "fish:ab": "bun scripts/ab-sample.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "openai": "^6.32.0"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}

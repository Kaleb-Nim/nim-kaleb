        Session -- "5. Stream prompt +<br/>conversation history" --> LLM
        LLM -. "6. Text chunks<br/>(sentence-boundary split)" .-> Session

        Session -- "7. input_text_buffer.append<br/><i>text chunks</i>" --> TTS
        TTS -. "8. response.audio.delta<br/><i>base64 PCM16 @ 24kHz</i>" .-> Session

        Session -- "9. response.audio.delta<br/><i>forwarded to browser</i>" --> Speaker
        Session -. "response.text.delta" .-> UI

        BargeIn -. "Cancel LLM + TTS<br/>on user interrupt" .-> LLM
        BargeIn -. "Cancel LLM + TTS<br/>on user interrupt" .-> TTS


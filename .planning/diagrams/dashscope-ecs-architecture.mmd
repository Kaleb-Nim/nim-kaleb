        UI == "1. Open WebSocket<br/><code>wss://ws.kalebnim.dev/ws</code>" ==> Session

        Mic -- "2. audio.append<br/><i>base64 PCM16 @ 16kHz</i>" --> Session
        Session -- "3. Forward audio" --> ASR
